# GovFlow AI — Environment Variables
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
APP_TITLE=GovFlow AI
APP_VERSION=0.1.0

# Langflow integration (leave blank to use deterministic stubs)
# Set this once you have a Langflow instance running.
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_FLOW_ID_PARSER=
LANGFLOW_FLOW_ID_SEVERITY=
LANGFLOW_FLOW_ID_BRIEF=

# API key for Langflow (if required by your Langflow instance)
LANGFLOW_API_KEY=
